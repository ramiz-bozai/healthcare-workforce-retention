# Laptop uv.toml points at pypi-proxy.dev.databricks.com. Databricks Apps cannot
# reach that host, so do not ship a lock with those URLs. Apps resolve pyproject
# against public PyPI.
uv.lock

# Keep frontend/dist committed so a Git-folder Databricks App can serve the SPA
# without npm in the workspace.

# Local secrets — never commit
.env
.env.*
!.env.example
credentials.json
**/*secret*
**/*credential*
